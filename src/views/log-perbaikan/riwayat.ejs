<div class="page-header">
  <div>
    <h3 class="mb-1">
      <i class="bi bi-clock-history text-primary me-1"></i>Riwayat Perbaikan
    </h3>
    <p class="page-subtitle">
      Daftar perbaikan barang yang sudah selesai ditangani.
    </p>
  </div>
  <a href="/log-perbaikan" class="btn btn-outline-secondary">
    <i class="bi bi-tools me-1"></i>Barang Rusak Aktif
  </a>
</div>

<!-- Filter -->
<form class="card mb-3" method="GET" action="/log-perbaikan/riwayat">
  <div class="card-body">
    <div class="row g-2">
      <div class="col-md-4">
        <input type="text" name="q" class="form-control" placeholder="Cari nama atau kode barang..." value="<%= filter.q %>" />
      </div>
      <div class="col-md-3">
        <select name="ruangan" class="form-select">
          <option value="">Semua Ruangan</option>
          <% daftarRuanganFilter.forEach(function(r) { %>
            <option value="<%= r.id %>" <%= filter.ruangan === r.id ? 'selected' : '' %>>
              <%= r.kodeRuangan %> — <%= r.namaRuangan %>
            </option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <input type="date" name="dariTanggal" class="form-control" value="<%= filter.dariTanggal %>" title="Dari tanggal" />
      </div>
      <div class="col-md-2">
        <input type="date" name="sampaiTanggal" class="form-control" value="<%= filter.sampaiTanggal %>" title="Sampai tanggal" />
      </div>
      <div class="col-md-1 d-grid">
        <button type="submit" class="btn btn-outline-primary">
          <i class="bi bi-search"></i>
        </button>
      </div>
    </div>
  </div>
</form>

<!-- List -->
<% if (daftarLog.length === 0) { %>
  <div class="empty-state">
    <div class="empty-icon"><i class="bi bi-clock-history"></i></div>
    <div class="empty-title">Belum Ada Riwayat Perbaikan</div>
    <p>Riwayat perbaikan akan muncul di sini setelah Anda menandai barang sudah diperbaiki.</p>
  </div>
<% } else { %>
  <div class="table-wrapper">
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Kode Barang</th>
            <th>Nama Barang</th>
            <th>Ruangan</th>
            <th>Tanggal Lapor</th>
            <th>Tanggal Selesai</th>
            <th>Durasi</th>
            <th>Ditangani Oleh</th>
            <th>Catatan</th>
          </tr>
        </thead>
        <tbody>
          <% daftarLog.forEach(function(log) { %>
            <%
              const lapor = new Date(log.tanggalLapor);
              const selesai = new Date(log.tanggalSelesai);
              const durasiMs = selesai - lapor;
              const durasiHari = Math.floor(durasiMs / (1000 * 60 * 60 * 24));
              const durasiJam = Math.floor((durasiMs % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
              let durasiText;
              if (durasiHari > 0) {
                durasiText = `${durasiHari} hari ${durasiJam} jam`;
              } else if (durasiJam > 0) {
                durasiText = `${durasiJam} jam`;
              } else {
                durasiText = '< 1 jam';
              }
            %>
            <tr>
              <td><code><%= log.barang.kodeBarang %></code></td>
              <td>
                <strong><%= log.barang.namaBarang %></strong>
                <br>
                <small class="text-muted-utama"><%= log.barang.kategori %></small>
              </td>
              <td>
                <small><%= log.barang.ruangan.kodeRuangan %></small><br>
                <%= log.barang.ruangan.namaRuangan %>
              </td>
              <td class="small">
                <%= lapor.toLocaleString('id-ID', {
                  day: '2-digit', month: 'short', year: 'numeric',
                  hour: '2-digit', minute: '2-digit'
                }) %>
              </td>
              <td class="small">
                <%= selesai.toLocaleString('id-ID', {
                  day: '2-digit', month: 'short', year: 'numeric',
                  hour: '2-digit', minute: '2-digit'
                }) %>
              </td>
              <td>
                <span class="badge varian-info"><%= durasiText %></span>
              </td>
              <td class="small"><%= log.penindak?.nama || '—' %></td>
              <td class="small text-muted-utama" style="max-width: 250px;">
                <%= log.catatan || '—' %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <p class="text-muted-utama small mt-2">
    Menampilkan <strong><%= daftarLog.length %></strong> riwayat perbaikan.
  </p>
<% } %>