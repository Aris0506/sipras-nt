<nav class="sipras-navbar">
  <div class="d-flex align-items-center">
    <button id="tombolSidebar" class="btn-toggle-sidebar" type="button" aria-label="Toggle menu">
      <i class="bi bi-list"></i>
    </button>
    <a class="navbar-brand" href="/dashboard">
      <img src="/img/logo.png" alt="YASINAT" class="brand-logo-img" />
      <span><%= appName %></span>
    </a>
  </div>

  <div class="d-flex align-items-center gap-2">
    <button id="tombolTema" class="btn-icon" type="button" aria-label="Toggle theme" title="Toggle theme">
      <i class="bi bi-moon-stars"></i>
    </button>

    <% if (userLogin) { %>
      <span class="user-info">
        <span class="user-avatar"><%= userLogin.nama.charAt(0).toUpperCase() %></span>
        <span class="d-none d-md-inline">
          <strong><%= userLogin.nama %></strong>
          <span class="text-muted-utama">· <%= userLogin.role === 'waka_sarpras' ? 'Waka Sarpras' : 'PJ Ruangan' %></span>
        </span>
      </span>
      <form action="/logout" method="POST" class="m-0">
        <button type="submit" class="btn-logout">
          <i class="bi bi-box-arrow-right"></i><span class="d-none d-md-inline">Logout</span>
        </button>
      </form>
    <% } %>
  </div>
</nav>