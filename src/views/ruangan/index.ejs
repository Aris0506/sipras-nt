<div class="page-header">
  <div>
    <h3 class="mb-1">Ruangan</h3>
    <p class="page-subtitle">Kelola data ruangan dan tetapkan penanggung jawabnya.</p>
  </div>
  <a href="/ruangan/baru" class="btn btn-primary">
    <i class="bi bi-door-open me-1"></i>Tambah Ruangan
  </a>
</div>

<!-- Filter -->
<form class="card mb-3" method="GET" action="/ruangan">
  <div class="card-body">
    <div class="row g-2">
      <div class="col-md-7">
        <input type="text" name="q" class="form-control" placeholder="Cari nama atau kode ruangan..." value="<%= filter.q %>" />
      </div>
      <div class="col-md-3">
        <select name="status" class="form-select">
          <option value="">Semua Status</option>
          <option value="aktif" <%= filter.status === 'aktif' ? 'selected' : '' %>>Aktif</option>
          <option value="nonaktif" <%= filter.status === 'nonaktif' ? 'selected' : '' %>>Nonaktif</option>
        </select>
      </div>
      <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-outline-primary">
          <i class="bi bi-search me-1"></i>Cari
        </button>
      </div>
    </div>
  </div>
</form>

<!-- List -->
<% if (daftarRuangan.length === 0) { %>
  <div class="empty-state">
    <div class="empty-icon"><i class="bi bi-door-closed"></i></div>
    <div class="empty-title">Belum Ada Ruangan</div>
    <p>Mulai tambahkan data ruangan sekolah.</p>
    <a href="/ruangan/baru" class="btn btn-sm btn-primary">
      <i class="bi bi-door-open me-1"></i>Tambah Ruangan
    </a>
  </div>
<% } else { %>
  <div class="table-wrapper">
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Kode</th>
            <th>Nama Ruangan</th>
            <th>PJ</th>
            <th>Jumlah Barang</th>
            <th>Status</th>
            <th class="text-end">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% daftarRuangan.forEach(function(r) { %>
            <tr>
              <td><code><%= r.kodeRuangan %></code></td>
              <td><strong><%= r.namaRuangan %></strong></td>
              <td>
                <% if (r.pj) { %>
                  <span class="badge varian-info"><i class="bi bi-person me-1"></i><%= r.pj.nama %></span>
                <% } else { %>
                  <span class="text-muted-utama small">— Belum ditetapkan</span>
                <% } %>
              </td>
              <td><%= r._count.barang %></td>
              <td>
                <% if (r.aktif) { %>
                  <span class="badge varian-sukses">Aktif</span>
                <% } else { %>
                  <span class="badge varian-rusak">Nonaktif</span>
                <% } %>
              </td>
              <td class="text-end">
                <div class="d-inline-flex gap-1">
                  <a href="/ruangan/<%= r.id %>/edit" class="btn btn-sm btn-outline-secondary" title="Edit">
                    <i class="bi bi-pencil"></i>
                  </a>
                  <% if (r.aktif) { %>
                    <% if (r.unlocks && r.unlocks.length > 0) { %>
                      <form action="/ruangan/<%= r.id %>/cancel-unlock" method="POST" class="m-0"
                            data-confirm="Tutup akses khusus untuk ruangan <%= r.namaRuangan %>?"
                            data-confirm-title="Tutup Akses Khusus"
                            data-confirm-varian="bahaya"
                            data-confirm-ok="Ya, Tutup">
                        <button type="submit" class="btn btn-sm btn-outline-warning" title="Tutup Akses Khusus (aktif)">
                          <i class="bi bi-lock-fill"></i>
                        </button>
                      </form>
                    <% } else { %>
                      <button type="button"
                              class="btn btn-sm btn-outline-secondary"
                              title="Buka Akses Khusus"
                              data-bs-toggle="modal"
                              data-bs-target="#modalUnlock"
                              data-ruangan-id="<%= r.id %>"
                              data-ruangan-nama="<%= r.namaRuangan %>">
                        <i class="bi bi-unlock"></i>
                      </button>
                    <% } %>
                  <% } %>
                  <form action="/ruangan/<%= r.id %>/nonaktifkan" method="POST" class="m-0"
                        data-confirm="<%= r.aktif ? 'Nonaktifkan' : 'Aktifkan kembali' %> ruangan <%= r.namaRuangan %>?"
                        data-confirm-title="<%= r.aktif ? 'Nonaktifkan Ruangan' : 'Aktifkan Ruangan' %>"
                        data-confirm-varian="<%= r.aktif ? 'bahaya' : 'info' %>"
                        data-confirm-ok="<%= r.aktif ? 'Ya, Nonaktifkan' : 'Ya, Aktifkan' %>">
                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="<%= r.aktif ? 'Nonaktifkan' : 'Aktifkan' %>">
                      <i class="bi bi-<%= r.aktif ? 'door-closed' : 'door-open' %>"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<!-- Modal: Buka Akses Khusus -->
<div class="modal fade" id="modalUnlock" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="formUnlock" method="POST" action="">
        <div class="modal-header">
          <h5 class="modal-title">
            <i class="bi bi-unlock me-1"></i>Buka Akses Khusus
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
        </div>
        <div class="modal-body">
          <p class="text-muted-utama small mb-3">
            Buka akses input/edit barang untuk ruangan
            <strong id="namaRuanganUnlock"></strong>
            di luar periode pengisian. Akses otomatis berakhir
            <strong>pukul 23:59 hari ini</strong>.
          </p>
          <div class="mb-3">
            <label class="form-label">
              Alasan Buka Akses <span class="text-danger">*</span>
            </label>
            <textarea name="alasan" class="form-control" rows="3"
                      placeholder="Contoh: AC baru masuk hari ini, perlu segera diinput sebelum periode bulan depan."
                      minlength="5"
                      required></textarea>
            <div class="form-text">Minimal 5 karakter. Akan tercatat di audit trail.</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            Batal
          </button>
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-unlock me-1"></i>Buka Akses
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  // Set action form & nama ruangan saat modal kebuka
  (function () {
    const modal = document.getElementById('modalUnlock');
    if (!modal) return;

    modal.addEventListener('show.bs.modal', function (event) {
      const tombol = event.relatedTarget;
      const ruanganId = tombol.getAttribute('data-ruangan-id');
      const ruanganNama = tombol.getAttribute('data-ruangan-nama');

      const form = document.getElementById('formUnlock');
      form.action = '/ruangan/' + ruanganId + '/unlock';

      document.getElementById('namaRuanganUnlock').textContent = ruanganNama;
    });
  })();
</script>