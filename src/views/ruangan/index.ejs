<div class="page-header">
  <div>
    <h3 class="mb-1">Ruangan</h3>
    <p class="page-subtitle">Kelola data ruangan dan tetapkan penanggung jawabnya.</p>
  </div>
  <a href="/ruangan/baru" class="btn btn-primary">
    <i class="bi bi-door-open me-1"></i>Tambah Ruangan
  </a>
</div>

<!-- Filter -->
<form class="card mb-3" method="GET" action="/ruangan">
  <div class="card-body">
    <div class="row g-2">
      <div class="col-md-7">
        <input type="text" name="q" class="form-control" placeholder="Cari nama atau kode ruangan..." value="<%= filter.q %>" />
      </div>
      <div class="col-md-3">
        <select name="status" class="form-select">
          <option value="">Semua Status</option>
          <option value="aktif" <%= filter.status === 'aktif' ? 'selected' : '' %>>Aktif</option>
          <option value="nonaktif" <%= filter.status === 'nonaktif' ? 'selected' : '' %>>Nonaktif</option>
        </select>
      </div>
      <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-outline-primary">
          <i class="bi bi-search me-1"></i>Cari
        </button>
      </div>
    </div>
  </div>
</form>

<!-- List -->
<% if (daftarRuangan.length === 0) { %>
  <div class="empty-state">
    <div class="empty-icon"><i class="bi bi-door-closed"></i></div>
    <div class="empty-title">Belum Ada Ruangan</div>
    <p>Mulai tambahkan data ruangan sekolah.</p>
    <a href="/ruangan/baru" class="btn btn-sm btn-primary">
      <i class="bi bi-door-open me-1"></i>Tambah Ruangan
    </a>
  </div>
<% } else { %>
  <div class="table-wrapper">
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Kode</th>
            <th>Nama Ruangan</th>
            <th>PJ</th>
            <th>Jumlah Barang</th>
            <th>Status</th>
            <th class="text-end">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% daftarRuangan.forEach(function(r) { %>
            <tr>
              <td><code><%= r.kodeRuangan %></code></td>
              <td><strong><%= r.namaRuangan %></strong></td>
              <td>
                <% if (r.pj) { %>
                  <span class="badge varian-info"><i class="bi bi-person me-1"></i><%= r.pj.nama %></span>
                <% } else { %>
                  <span class="text-muted-utama small">— Belum ditetapkan</span>
                <% } %>
              </td>
              <td><%= r._count.barang %></td>
              <td>
                <% if (r.aktif) { %>
                  <span class="badge varian-sukses">Aktif</span>
                <% } else { %>
                  <span class="badge varian-rusak">Nonaktif</span>
                <% } %>
              </td>
              <td class="text-end">
                <div class="d-inline-flex gap-1">
                  <a href="/ruangan/<%= r.id %>/edit" class="btn btn-sm btn-outline-secondary" title="Edit">
                    <i class="bi bi-pencil"></i>
                  </a>           
                  <form action="/ruangan/<%= r.id %>/nonaktifkan" method="POST" class="m-0"
                        data-confirm="<%= r.aktif ? 'Nonaktifkan' : 'Aktifkan kembali' %> ruangan <%= r.namaRuangan %>?"
                        data-confirm-title="<%= r.aktif ? 'Nonaktifkan Ruangan' : 'Aktifkan Ruangan' %>"
                        data-confirm-varian="<%= r.aktif ? 'bahaya' : 'info' %>"
                        data-confirm-ok="<%= r.aktif ? 'Ya, Nonaktifkan' : 'Ya, Aktifkan' %>">
                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="<%= r.aktif ? 'Nonaktifkan' : 'Aktifkan' %>">
                      <i class="bi bi-<%= r.aktif ? 'door-closed' : 'door-open' %>"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>