<h3 class="mb-4"><i class="bi bi-key"></i> Ganti Password</h3>

<div class="card">
  <div class="card-body">
    <form action="/ganti-password" method="POST" style="max-width: 400px;">
      <div class="mb-3">
        <label class="form-label">Password Lama</label>
        <input type="password" name="passwordLama" class="form-control" required />
      </div>
      <div class="mb-3">
        <label class="form-label">Password Baru</label>
        <input type="password" name="passwordBaru" class="form-control" required minlength="8" />
        <div class="form-text">Minimal 8 karakter.</div>
      </div>
      <div class="mb-3">
        <label class="form-label">Konfirmasi Password Baru</label>
        <input type="password" name="passwordBaruKonfirmasi" class="form-control" required minlength="8" />
      </div>
      <button type="submit" class="btn btn-primary">Simpan</button>
    </form>
  </div>
</div>
