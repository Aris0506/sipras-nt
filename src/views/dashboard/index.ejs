<h3 class="mb-4"><i class="bi bi-speedometer2"></i> Dashboard</h3>

<% if (userLogin && userLogin.role === 'waka_sarpras') { %>
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card text-bg-primary">
        <div class="card-body">
          <h6 class="card-title">Total Ruangan</h6>
          <p class="display-6 mb-0">—</p>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-bg-success">
        <div class="card-body">
          <h6 class="card-title">Total Barang</h6>
          <p class="display-6 mb-0">—</p>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-bg-warning">
        <div class="card-body">
          <h6 class="card-title">Barang Rusak</h6>
          <p class="display-6 mb-0">—</p>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-bg-info">
        <div class="card-body">
          <h6 class="card-title">PJ Aktif</h6>
          <p class="display-6 mb-0">—</p>
        </div>
      </div>
    </div>
  </div>
<% } else { %>
  <div class="alert alert-info">
    <i class="bi bi-info-circle"></i>
    Selamat datang, <strong><%= userLogin?.nama %></strong>. Silakan kelola barang ruangan Anda melalui menu di samping.
  </div>
<% } %>

<p class="text-muted">Halaman dashboard masih placeholder. Data akan diisi pada iterasi berikutnya.</p>
